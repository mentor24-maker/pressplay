# Copy to .env.local — get these from your Supabase project settings → API
#
# NOTE: every comment below sits on its OWN line, deliberately. A .env file
# ignores anything after a "#", but the Vercel dashboard does not — whatever is
# in the box is the value, comment and all. A trailing comment pasted into
# Vercel once broke SUPABASE_SERVICE_ROLE_KEY, because the em dash in it cannot
# be encoded into an HTTP header. Keep values alone on their line.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Any random string; Vercel Cron sends it as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-me

# Server only. Claude writes the private fact sheets with it (PP-5); without
# it that step does not run and says so. Spending stops at $10 a month.
# Create one at console.anthropic.com, under API keys.
ANTHROPIC_API_KEY=sk-ant-...
